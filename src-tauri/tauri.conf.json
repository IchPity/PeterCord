{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeterCord",
  "version": "../package.json",
  "identifier": "at.ichpity.petercord",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PeterCord",
        "width": 1180,
        "height": 760,
        "minWidth": 420,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#14201e",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: wss: http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' https: http://127.0.0.1:* data: blob:; media-src 'self' https: http://127.0.0.1:* blob: mediastream:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "IchPity",
    "shortDescription": "PeterCord – Chat für Freunde",
    "longDescription": "Direktnachrichten, Gruppen, Sprachchat und Bildschirmübertragung – schlank und schnell.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxNDQ1RjQ1RkEwRTFGMTQKUldRVUh3NzZSVjlFTWJjcU5POTBsMFNUU1BkbVJEVlNsS3dlb3RhWkZWQS9hdktNYTNiY0N1Nk4K",
      "endpoints": ["https://github.com/IchPity/PeterCord/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
